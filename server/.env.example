NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# Database Configuration
# Set DB_PROVIDER to either "postgresql" or "mysql"
DB_PROVIDER=postgresql

# PostgreSQL URL
DATABASE_URL=postgresql://user:password@localhost:5432/invoice_db

# MySQL URL (alternative - change DB_PROVIDER to mysql)
# DATABASE_URL=mysql://user:password@localhost:3306/invoice_db

JWT_SECRET=your-super-secret-jwt-key-here
REDIS_URL=redis://localhost:6379
GATEWAY_SECRET=your-gateway-secret-key-here
